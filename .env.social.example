# Social isolated environment — template only. Never commit real values.
# Must point to a NEW database with its own role and credentials.
SOCIAL_DATABASE_URL=postgresql://social_user:REPLACE_ME@127.0.0.1:5432/social_db
# Separate cookie name and signing keys from h00k.
SOCIAL_SESSION_COOKIE=social_session
SOCIAL_APP_ORIGIN=http://localhost:3000
# SMTP must be configured before enabling email verification.
SOCIAL_SMTP_URL=
SOCIAL_MAIL_FROM=
